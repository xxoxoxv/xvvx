# AMOS-Federation Environment Variables
# الهدف: قالب للإعدادات البيئية
# النطاق: federal/executive/services
# المالك: federal/executive/services
# تاريخ الإنشاء: 2026-08-15

# App
AMOS_ENVIRONMENT=development
AMOS_DEBUG=true

# PostgreSQL
AMOS_POSTGRES_HOST=localhost
AMOS_POSTGRES_PORT=5432
AMOS_POSTGRES_DB=amos_federation
AMOS_POSTGRES_USER=amos
AMOS_POSTGRES_PASSWORD=dev_password_change_me

# Redis
AMOS_REDIS_HOST=localhost
AMOS_REDIS_PORT=6379

# NATS
AMOS_NATS_URL=nats://localhost:4222

# Qdrant
AMOS_QDRANT_HOST=localhost
AMOS_QDRANT_PORT=6333

# MinIO
AMOS_MINIO_ENDPOINT=localhost:9000
AMOS_MINIO_ACCESS_KEY=amos
AMOS_MINIO_SECRET_KEY=dev_password_change_me

# JWT
AMOS_JWT_SECRET=dev_secret_change_me
AMOS_JWT_ALGORITHM=HS256

# OpenTelemetry
AMOS_OTLP_ENDPOINT=http://localhost:4317

# Model Gateway
AMOS_CLAUDE_API_KEY=your_api_key_here
AMOS_DEFAULT_MODEL=claude-sonnet-4-20250514
