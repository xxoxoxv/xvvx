# AMOS-Federation — متغيرات البيئة (قالب للتطوير)
# المالك: المالك المطلق للدولة (zoorooz)
# تحذير: استبدل القيم الوهمية ببياناتك الخاصة. لا تلتزم أبدًا أسرار حقيقية.

# === Supabase PostgreSQL ===
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@db.YOUR_PROJECT.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE
SUPABASE_DB_HOST=db.YOUR_PROJECT.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres

# ملاحظة تشغيلية: بيئة الـ sandbox الحالية لا تستطيع الوصول المباشر لمضيف Supabase
# (TCP 5432 محظور، الشبكة تمرر github.com فقط عبر البروكسي). الـAMOS runtime يتصل بها
# في بيئته الخاصة. للتحقق من هنا لاحقًا: توفير وصول شبكة مباشر للمضيف، أو تشغيل
# اختبارات PostgreSQL عبر الـ runtime.
