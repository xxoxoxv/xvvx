```gitignore
# Python compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Logs and temporary files
*.log
*.tmp
*.swp
*.swo

# Environment files
.env
.env.local
*.env.*

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
.coverage

# IDE specific files
.vscode/
.idea/

# Distribution / build artifacts
dist/
build/
target/

# Virtual environments
venv/
.venv/
```